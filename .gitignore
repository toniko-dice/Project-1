# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload
/media
*.db
*.db-journal

# Архиви
/backups
/.backup-tmp
/.restore-staging

# Проверки на здравето
/.health
/.rescue

# Снимките на продуктите — свалят се наново по snimki-za-svalyane.txt,
# а истинските се пазят в архива заедно с media/. Git държи само
# текстовото съдържание (sadarzhanie.json, бележките, списъците с адреси).
content/*/galeriya/
content/*/galeryia/
content/*/sekcii/
content/referentsia/
