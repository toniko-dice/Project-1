PAYLOAD_SECRET=
DATABASE_URI=file:./ecoflow.db

# Адресът на админа/сайта в браузъра. На сървъра, докато е през SSH тунела:
# http://localhost:8080; с домейна — https://ecoflow.bg.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Където сайтът пита сам себе си (middleware: заключването и пренасочванията;
# опресняването след внос и синхронизация). На сървъра: http://127.0.0.1:3000.
# Празно — адресът на заявката / NEXT_PUBLIC_SERVER_URL.
INTERNAL_SERVER_URL=

# Адресът на сайта — ЕДНА настройка за всеки пълен адрес: robots.txt, sitemap,
# canonical, og:url, og:image, JSON-LD (src/lib/site-url.ts).
# На сървъра: истинският адрес, напр. https://ecoflow.bg — без него или с
# localhost `npm run build` спира. Локално остава localhost; за проверка на
# билда на локалната машина: `npm run build:local` (никога за сървъра).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Поща (заявките за оферта, src/lib/quote/mail.ts) ───
# Без SMTP_HOST (или с EMAIL_MODE=log) писмата НЕ се изпращат — записват се в
# mail-log/ и в лога (src/lib/mail-log.ts). Така е на сървъра, докато няма SMTP.
EMAIL_MODE=
# Локално: `npm run mail:catcher` и SMTP_HOST=127.0.0.1, SMTP_PORT=1025,
# SMTP_SECURE=false, без потребител — писмата отиват в tmp-mail/.
# На сървъра: SMTP на пощенския доставчик + DNS записите (README „Имейли").
SMTP_HOST=
SMTP_PORT=587
# true за порт 465 (TLS от началото); false за 587 (STARTTLS) и 1025 локално.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoFlow България <noreply@ecoflow.bg>
# Къде отива вътрешният имейл за нова заявка.
QUOTE_NOTIFY_TO=support@dice.bg

# Заключен достъп (сайтът се вижда само след вход с акаунт за админа).
# Включва/изключва се с отметката в „Общи настройки" → „Заключен достъп".
#   force-off — авариен ключ: отворено, каквото и да пише в админа;
#   force-on  — заключено и при `npm run dev` (иначе в dev е отворено).
SITE_GATE=

# ─── Сървърът (README „Сървър") ───
# Главната база е на СЪРВЪРА. Локално синхронизацията с dice.bg е изключена:
DICE_SYNC_DISABLED=true
# Само в .env НА СЪРВЪРА и само за еднократното качване на базата
# (npm run db:kachi-na-sarvara) — после се маха:
# ALLOW_DB_UPLOAD=true

