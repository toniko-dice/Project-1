PAYLOAD_SECRET=
DATABASE_URI=file:./ecoflow.db

# Адресът, на който вървят скриптовете (вносът вика оттук опресняването на кеша).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Адресът на сайта — ЕДНА настройка за всеки пълен адрес: robots.txt, sitemap,
# canonical, og:url, og:image, JSON-LD (src/lib/site-url.ts).
# На сървъра: истинският адрес, напр. https://ecoflow.bg — без него или с
# localhost `npm run build` спира. Локално остава localhost; за проверка на
# билда на локалната машина: `npm run build:local` (никога за сървъра).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
