PAYLOAD_SECRET=
DATABASE_URI=file:./ecoflow.db

# Адресът, на който вървят скриптовете (вносът вика оттук опресняването на кеша).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Адресът на сайта — ЕДНА настройка за всеки пълен адрес: robots.txt, sitemap,
# canonical, og:url, og:image, JSON-LD (src/lib/site-url.ts).
# На сървъра: истинският адрес, напр. https://bg-ecoflow.com — без него или с
# localhost `npm run build` спира. Локално остава localhost; за проверка на
# билда на локалната машина: `npm run build:local` (никога за сървъра).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Поща (заявките за оферта, src/lib/quote/mail.ts) ───
# Без SMTP_HOST имейлите не се изпращат — Payload ги пише в конзолата.
# Локално: `npm run mail:catcher` и SMTP_HOST=127.0.0.1, SMTP_PORT=1025,
# SMTP_SECURE=false, без потребител — писмата отиват в tmp-mail/.
# На сървъра: SMTP на пощенския доставчик + DNS записите (README „Имейли").
SMTP_HOST=
SMTP_PORT=587
# true за порт 465 (TLS от началото); false за 587 (STARTTLS) и 1025 локално.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EcoFlow България <noreply@bg-ecoflow.com>
# Къде отива вътрешният имейл за нова заявка.
QUOTE_NOTIFY_TO=support@dice.bg

# Заключен достъп (сайтът се вижда само след вход с акаунт за админа).
# Включва/изключва се с отметката в „Общи настройки" → „Заключен достъп".
#   force-off — авариен ключ: отворено, каквото и да пише в админа;
#   force-on  — заключено и при `npm run dev` (иначе в dev е отворено).
SITE_GATE=
