# fail2ban — адреси, които никога не се банват (всички правила без sshd,
# което има свой списък в jail.d/sshd.local — същите адреси).
# На сървъра: /etc/fail2ban/jail.local.
#   127.0.0.1, ::1 — тунелът и самият сървър;
#   77.78.23.101   — собственикът (първоначалният адрес);
#   90.154.206.1   — офисът (13.10.2026; Cowork тества /.env и /wp-* оттук).
# Сменя ли се IP-то на офиса — тук и в sshd.local, после
# `systemctl reload fail2ban`.
[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 77.78.23.101 90.154.206.1
