# fail2ban — сайтът (`task-fail2ban-bez-blokirane.md`, 13 октомври 2026).
# На сървъра: /etc/fail2ban/jail.d/ecoflow.local; филтърът — filter.d/.
#
# Принцип: лошите заявки се ОТКАЗВАТ от nginx (444 / 404 / 429), IP-то не се
# банва — освен при упорита атака срещу входа. Посетителите и служителите
# са с динамични адреси: бял списък не помага, нормален човек не бива да
# бъде блокиран. Затова:
#   - сканирането (/.env, /wp-*…) — БЕЗ правило: nginx затваря връзката (444);
#     на 13.10.2026 правилото за сканиране банна офиса при проверка;
#   - nginx-limit-req — махнато: 429 на nginx е достатъчно;
#   - входът — само при 30 опита за 10 мин., бан 15 мин., без нарастване;
#   - recidive — няма.
# Банът спира САМО 80 и 443 (`port = http,https`) — SSH остава.
# `backend = auto` — в Ubuntu по подразбиране е `systemd` (журналът), а
# nginx пише във файл.
# Кои адреси никога не се банват — /etc/fail2ban/jail.local
# (deploy/fail2ban/jail.local); НЕ тук: jail.d/*.local го презаписва.

[ecoflow-login]
enabled  = true
port     = http,https
filter   = ecoflow-login
logpath  = /var/log/nginx/access.log
backend  = auto
maxretry = 30
findtime = 10m
bantime  = 15m
bantime.increment = false
# Зад Cloudflare (ecoflow.bg, 16.10.2026): на 80/443 идват само IP-тата на
# Cloudflare — бан в nftables по истинския IP не спира нищо, а по IP-то на
# Cloudflare би спрял всички. Затова действието е само запис (`dummy`):
# „Ban …" в /var/log/fail2ban.log и в дневния отчет. Входът се пази от
# limit_req в nginx (10/мин.) и от заключването на акаунта (5 опита).
banaction = dummy
