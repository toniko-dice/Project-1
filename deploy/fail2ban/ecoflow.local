# fail2ban — сайтът (`task-otvaryane-https-ip.md`).
# На сървъра: /etc/fail2ban/jail.d/ecoflow.local; филтрите — filter.d/.
# Кои адреси не се банват — /etc/fail2ban/jail.local (deploy/fail2ban/jail.local).
# НЕ тук: jail.d/*.local се чете СЛЕД jail.local и би го презаписал.
# `backend = auto` — в Ubuntu по подразбиране е `systemd` (журналът), а
# nginx пише във файл: без него правилата никога не се задействат.

# Много грешни входове / ограничени заявки към входа от един IP → 1 час.
[ecoflow-login]
enabled  = true
port     = http,https
filter   = ecoflow-login
logpath  = /var/log/nginx/access.log
backend  = auto
maxretry = 10
findtime = 10m
bantime  = 1h

# Сканиране за чужди системи (/wp-*, /.env, /.git…) → 1 час.
[ecoflow-scan]
enabled  = true
port     = http,https
filter   = ecoflow-scan
logpath  = /var/log/nginx/access.log
backend  = auto
maxretry = 3
findtime = 10m
bantime  = 1h

# Надхвърлен лимит на nginx (limit_req) — от error.log, вграденият филтър.
[nginx-limit-req]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/error.log
backend  = auto
maxretry = 20
findtime = 10m
bantime  = 1h
