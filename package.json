{
  "name": "ecoflow-bg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "prebuild": "node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "media:regenerate": "payload run src/media-regenerate.ts --",
    "migrate:tree": "payload run src/migrate-tree.ts --",
    "seed": "payload run src/seed.ts --",
    "migrate": "payload run src/pre-migrate.ts && payload run src/health-check.ts && payload migrate && payload run src/health-check.ts",
    "migrate:create": "payload migrate:create",
    "migrate:status": "payload migrate:status",
    "migrate:fresh": "payload migrate:fresh",
    "backfill:order": "payload run src/backfill-order.ts",
    "import:product": "payload run src/import-product.ts --",
    "import:all": "payload run src/import-all.ts --",
    "import:attributes": "payload run src/import-attributes.ts --",
    "seed:attributes": "payload run src/seed-attributes.ts --",
    "snimki:bql-fon": "payload run src/snimki-bql-fon.ts --",
    "snimki:zameni": "payload run src/snimki-zameni.ts --",
    "snimki:imena": "payload run src/snimki-imena.ts --",
    "snimki:proverka": "node scripts/snimki-proverka.mjs",
    "health": "payload run src/health-check.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@phosphor-icons/react": "^2.1.10",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "graphql": "^16.14.2",
    "next": "16.3.1",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.103.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
